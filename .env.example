WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:3000/api/auth/whoop/callback
WHOOP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Spotify live BPM DJ: register this exact callback in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_SESSION_SECRET=replace-with-a-separate-secret-of-at-least-32-random-characters
# Optional override; normally leave empty to verify with WHOOP_CLIENT_SECRET.
# Register https://YOUR-HOST/api/whoop/webhook as a WHOOP v2 webhook.
WHOOP_WEBHOOK_SECRET=
# Same 32+ character secret in Next.js and Convex; protects owner diagnostic storage.
WHOOP_SETUP_SECRET=
# Required for stored history/messages: identical 32+ character value in Next.js and Convex.
WHOOP_SERVER_SECRET=
# Optional: numeric WHOOP ID allowed to open /admin/whoop.
WHOOP_ADMIN_USER_ID=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=http://localhost:3000/api/auth/garmin/callback
GARMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_CONVEX_URL=
# Optional: explicitly publish only this account at /public; leave blank for private use.
WHOOP_PUBLIC_USER_ID=
DAILY_MESSAGE_SECRET=replace-with-at-least-32-random-characters
# Required for the daily 04:30 UTC Vercel fallback (not for webhook delivery).
CRON_SECRET=replace-with-at-least-16-random-characters
LINQ_API_KEY=
# Optional local development transport; production keeps using the REST API.
LINQ_TRANSPORT=api
# Absolute path from `which linq`, useful with nvm. Empty uses PATH.
LINQ_CLI_PATH=
# Optional CLI profile/sender; a nonempty LINQ_API_KEY overrides profile credentials.
LINQ_PROFILE=
LINQ_FROM_PHONE=
# REST only: iMessage, RCS, or SMS.
LINQ_PREFERRED_SERVICE=
DAILY_MESSAGE_GREETING=Good morning Mom
